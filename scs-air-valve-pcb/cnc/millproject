# Common options
basename=lconv
output-dir=./mill
metric=true
metricoutput=true
zsafe=1.0
zchange=30.0

# Milling
# front=../gerber/
back=../gerber/air-valve-pcb-B_Cu.gbr
mill-diameters=0.5
voronoi=true
# milling-overlap=
# isolation-width=1
zwork=-0.04
mill-feed=200
mill-speed=10000

# Drilling
drill=../gerber/air-valve-pcb.drl
drill-feed=100
drill-side=back
drill-speed=10000
milldrill=true
milldrill-diameter=0.8
nog81=true
nog91-1=true
nom6=true
onedrill=true
zdrill=-1.7

# Outline
outline=../gerber/air-valve-pcb-Edge_Cuts.gbr
cutter-diameter=0.8
zcut=-1.7
bridges=0.5000
bridgesnum=4
zbridges=-1.2
cut-feed=200
cut-infeed=0.25
cut-speed=10000
cut-vertfeed=60
cut-side=back
