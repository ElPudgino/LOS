# Common options
basename=lconv
output-dir=./mill
metric=true
metricoutput=true
zsafe=3.0
zchange=20.0

# Milling
front=../gerber/scs-receiver-pcb-v1-F_Cu.gbr
# back=../gerber/
mill-diameters=0.5
voronoi=false
# milling-overlap=
isolation-width=10
zwork=-0.04
mill-feed=150
mill-speed=10000

# Drilling
drill=../gerber/scs-receiver-pcb-v1.drl
drill-feed=100
drill-side=front
drill-speed=10000
milldrill=true
milldrill-diameter=0.5
nog81=true
nog91-1=true
nom6=true
onedrill=true
zdrill=-1.7

# Outline
outline=../gerber/scs-receiver-pcb-v1-Edge_Cuts.gbr
cutter-diameter=0.8
zcut=-1.7
bridges=0.5000
bridgesnum=4
zbridges=-1.2
cut-feed=200
cut-infeed=0.25
cut-speed=10000
cut-vertfeed=60
cut-side=front
