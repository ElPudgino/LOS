# Common options
basename=lconv
output-dir=./mill
metric=true
metricoutput=true
zsafe=1.0
zchange=30.0

# Milling
front=../gerber/stand-ps-F_Cu.gbr
# back=
mill-diameters=1
voronoi=false
# milling-overlap=
isolation-width=20
zwork=-0.04
mill-feed=400
mill-speed=10000

# Drilling
drill=../gerber/stand-ps.drl
drill-feed=100
drill-side=front
drill-speed=10000
milldrill=true
milldrill-diameter=0.8
nog81=true
nog91-1=true
nom6=true
onedrill=true
zdrill=-1.8

# Outline
outline=../gerber/stand-ps-Edge_Cuts.gbr
cutter-diameter=0.8
zcut=-1.7
bridges=0.5000
bridgesnum=4
zbridges=-1.2
cut-feed=200
cut-infeed=0.25
cut-speed=10000
cut-vertfeed=60
cut-side=front
